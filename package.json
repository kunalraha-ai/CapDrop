{
  "name": "capdrop",
  "displayName": "CapDrop",
  "description": "Orchestrates a local multi-persona developer agent loop inside VS Code.",
  "version": "0.1.0",
  "publisher": "antigravity",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "capdrop.startAgent",
        "title": "CapDrop: Start Active Persona Session"
      },
      {
        "command": "capdrop.runBuild",
        "title": "CapDrop: Run Integration Expert Build Loop"
      },
      {
        "command": "capdrop.openCapsuleLibrary",
        "title": "CapDrop: Open Capsule Library"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --watch --mode development",
    "package": "webpack --mode production --devtool hidden-source-map",
    "deploy": "vsce package && code --install-extension capdrop-0.1.0.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
