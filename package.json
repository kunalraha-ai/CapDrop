{
  "name": "capdrop",
  "displayName": "CapDrop",
  "description": "Drop a capsule. Shift your AI's role. Ship better code. Role-based system prompts that keep AI coding assistants in their lane.",
  "version": "0.0.1",
  "publisher": "KunalRaha",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kunalraha-ai/CapDrop.git"
  },
  "icon": "icon.png",
  "homepage": "https://github.com/kunalraha-ai/CapDrop#readme",
  "bugs": {
    "url": "https://github.com/kunalraha-ai/CapDrop/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "gemini",
    "prompt",
    "persona",
    "capsule",
    "boundary",
    "vibe-coding",
    "system-prompt"
  ],
  "galleryBanner": {
    "color": "#0d0d0d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "capdrop.startAgent",
        "title": "CapDrop: Start Active Persona Session"
      },
      {
        "command": "capdrop.runBuild",
        "title": "CapDrop: Run Integration Expert Build Loop"
      },
      {
        "command": "capdrop.openCapsuleLibrary",
        "title": "CapDrop: Open Capsule Library"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development",
    "watch": "webpack --watch --mode development",
    "package": "webpack --mode production --devtool hidden-source-map",
    "deploy": "vsce package && code --install-extension capdrop-0.0.1.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
